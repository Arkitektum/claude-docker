{
  "name": "Claude Code Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}",
      "LOCAL_USER": "${localEnv:USER:claude}",
      "LOCAL_UID": "${localEnv:UID:1000}",
      "LOCAL_GID": "${localEnv:GID:1000}"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=AUDIT_WRITE"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "${localEnv:USER:claude}",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/${localEnv:USER:claude}/.claude"
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/${localEnv:USER:claude}/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/${localEnv:USER:claude}/.claude.json,type=bind,consistency=cached"
  ],
  "initializeCommand": ".devcontainer/init-host",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "/usr/local/bin/entrypoint.sh true",
  "waitFor": "postStartCommand"
}
