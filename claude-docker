#!/bin/bash

IMAGE_NAME="claude-code"
IMAGE_TAG="latest"
IMAGE="${IMAGE_NAME}:${IMAGE_TAG}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-docker"

# Parse flags
REBUILD_FLAG=""
NO_FIREWALL=""
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --rebuild) REBUILD_FLAG="--no-cache" ;;
    --no-firewall) NO_FIREWALL=1 ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

# Ensure Claude config exists on host before bind-mounting
mkdir -p "${HOME}/.claude"
touch "${HOME}/.claude.json"

# Get local username and UID/GID
LOCAL_USER="${USER}"
LOCAL_UID="$(id -u)"
LOCAL_GID="$(id -g)"

# Verify build context exists
if [ ! -f "$DATA_DIR/Dockerfile" ]; then
  echo "Error: Dockerfile not found at $DATA_DIR/Dockerfile" >&2
  echo "Run install.sh first." >&2
  exit 1
fi

# Seed marketplace plugins into build context
if [ -x "$DATA_DIR/seed-plugins.sh" ]; then
  "$DATA_DIR/seed-plugins.sh" "$DATA_DIR/plugin-seed" ||
    echo "Warning: failed to seed marketplace plugins, continuing without plugins" >&2
fi

# Build image
if ! docker build $REBUILD_FLAG \
  --build-arg LOCAL_USER="$LOCAL_USER" \
  --build-arg LOCAL_UID="$LOCAL_UID" \
  --build-arg LOCAL_GID="$LOCAL_GID" \
  -t "$IMAGE" \
  "$DATA_DIR"; then
  exit $?
fi

# Check if bash was requested
CMD="claude"
if [ "$1" = "bash" ]; then
  CMD="bash"
  shift
fi

# Build docker run arguments
RUN_ARGS=(
  -it --rm
  -v "$(pwd):$(pwd)"
  -v "${HOME}/.claude:/home/${LOCAL_USER}/.claude"
  -v "${HOME}/.claude.json:/home/${LOCAL_USER}/.claude.json"
  -e LANG="C.UTF-8"
  -e LC_ALL="C.UTF-8"
  -e COLORTERM=truecolor
  -w "$(pwd)"
)

if [ -n "$NO_FIREWALL" ]; then
  # No firewall: host networking, drop all capabilities, run as host user
  RUN_ARGS+=(
    --user "${LOCAL_UID}:${LOCAL_GID}"
    --security-opt=no-new-privileges:true
    --net=host
    --cap-drop=ALL
    --entrypoint bash
  )
  PROMPT_ARGS=""
  [ "$CMD" = "claude" ] && PROMPT_ARGS="--append-system-prompt-file /etc/claude-code/container.md"
  docker run "${RUN_ARGS[@]}" "$IMAGE" -c "/usr/local/bin/setup-plugins.sh && exec $CMD $PROMPT_ARGS \"\$@\"" -- "$@"
else
  # Firewall: bridge networking, start as root for iptables, then exec as user
  RUN_ARGS+=(
    --user root
    --cap-drop=ALL
    --cap-add=NET_ADMIN
    --cap-add=NET_RAW
  )
  CONTAINER_ID=$(docker run -d --init "${RUN_ARGS[@]}" "$IMAGE" sleep infinity)
  trap "docker rm -f $CONTAINER_ID >/dev/null 2>&1" EXIT
  if ! docker exec "$CONTAINER_ID" /usr/local/bin/init-firewall.sh; then
    echo "Firewall init failed, refusing to start without firewall." >&2
    echo "Use --no-firewall to skip." >&2
    exit 1
  fi
  docker exec --user "${LOCAL_UID}:${LOCAL_GID}" "$CONTAINER_ID" /usr/local/bin/setup-plugins.sh
  if [ "$CMD" = "claude" ]; then
    docker exec -it --user "${LOCAL_UID}:${LOCAL_GID}" "$CONTAINER_ID" "$CMD" --append-system-prompt-file /etc/claude-code/container.md "$@"
  else
    docker exec -it --user "${LOCAL_UID}:${LOCAL_GID}" "$CONTAINER_ID" "$CMD" "$@"
  fi
fi
