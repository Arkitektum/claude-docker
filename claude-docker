#!/bin/bash

IMAGE_NAME="claude-code"
IMAGE_TAG="latest"
IMAGE="${IMAGE_NAME}:${IMAGE_TAG}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-docker"

# Parse flags
REBUILD_FLAG=""
NO_FIREWALL=""
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --rebuild) REBUILD_FLAG="--no-cache" ;;
    --no-firewall) NO_FIREWALL=1 ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

# Ensure Claude config directory exists
mkdir -p "${HOME}/.claude"

# Migrate .claude.json into .claude/ directory so we only need directory mounts
# (single-file bind mounts don't work on Mac Docker Desktop).
# Canonical location: ~/.claude/.claude.json, with ~/.claude.json as a symlink.
if [ -L "${HOME}/.claude.json" ]; then
  [ -f "${HOME}/.claude/.claude.json" ] || echo '{}' > "${HOME}/.claude/.claude.json"
elif [ -f "${HOME}/.claude.json" ] && [ -f "${HOME}/.claude/.claude.json" ]; then
  cat >&2 <<'CONFLICT'
Error: Found .claude.json in two locations:

  1. ~/.claude.json
  2. ~/.claude/.claude.json

This happened because an earlier version of claude-docker incorrectly created
the second file. Only ONE of them has your real Claude config (OAuth tokens,
settings, etc). The other is likely an empty '{}' or stale copy.

To fix this, compare the two files and keep the real one:

  diff ~/.claude.json ~/.claude/.claude.json

Then pick one:

  # If ~/.claude.json is the real one:
  cp ~/.claude.json ~/.claude/.claude.json
  rm ~/.claude.json
  ln -s ~/.claude/.claude.json ~/.claude.json

  # If ~/.claude/.claude.json is the real one:
  rm ~/.claude.json
  ln -s ~/.claude/.claude.json ~/.claude.json

After fixing, re-run this command.
CONFLICT
  exit 1
else
  # Ensure canonical file exists (copy from outer file, or create fresh)
  [ -f "${HOME}/.claude/.claude.json" ] || cp "${HOME}/.claude.json" "${HOME}/.claude/.claude.json" 2>/dev/null || echo '{}' > "${HOME}/.claude/.claude.json"
  ln -sf "${HOME}/.claude/.claude.json" "${HOME}/.claude.json"
fi

# Get local username and UID/GID
LOCAL_USER="${USER}"
LOCAL_UID="$(id -u)"
LOCAL_GID="$(id -g)"

# Verify build context exists
if [ ! -f "$DATA_DIR/Dockerfile" ]; then
  echo "Error: Dockerfile not found at $DATA_DIR/Dockerfile" >&2
  echo "Run install.sh first." >&2
  exit 1
fi

# Seed marketplace plugins into build context
if [ -x "$DATA_DIR/seed-plugins.sh" ]; then
  "$DATA_DIR/seed-plugins.sh" "$DATA_DIR/plugin-seed" ||
    echo "Warning: failed to seed marketplace plugins, continuing without plugins" >&2
fi

# Build image
if ! docker build $REBUILD_FLAG \
  --build-arg LOCAL_USER="$LOCAL_USER" \
  --build-arg LOCAL_UID="$LOCAL_UID" \
  --build-arg LOCAL_GID="$LOCAL_GID" \
  -t "$IMAGE" \
  "$DATA_DIR"; then
  exit $?
fi

# Check if bash was requested
CMD="claude"
if [ "${1:-}" = "bash" ]; then
  CMD="bash"
  shift
fi

# Build docker run arguments
RUN_ARGS=(
  -it --rm --init
  --add-host=host.docker.internal:host-gateway
  -v "$(pwd):$(pwd)"
  -v "${HOME}/.claude:/home/${LOCAL_USER}/.claude"
  -e LANG="C.UTF-8"
  -e LC_ALL="C.UTF-8"
  -e COLORTERM=truecolor
  -w "$(pwd)"
)

if [ -n "$NO_FIREWALL" ]; then
  RUN_ARGS+=(
    --security-opt=no-new-privileges:true
    --net=host
    --cap-drop=ALL
    -e DISABLE_FIREWALL=1
  )
else
  RUN_ARGS+=(
    --cap-drop=ALL
    --cap-add=NET_ADMIN
    --cap-add=NET_RAW
    --cap-add=SETUID
    --cap-add=SETGID
    --cap-add=AUDIT_WRITE
  )
fi

docker run "${RUN_ARGS[@]}" "$IMAGE" "$CMD" "$@"
