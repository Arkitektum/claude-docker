#!/bin/bash

IMAGE_NAME="claude-code"
IMAGE_TAG="latest"
IMAGE="${IMAGE_NAME}:${IMAGE_TAG}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-docker"

# Parse flags
REBUILD_FLAG=""
NO_FIREWALL=""
ADD_DIRS=()
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --rebuild) REBUILD_FLAG="--no-cache" ;;
    --no-firewall) NO_FIREWALL=1 ;;
    --add-dir=*) ADD_DIRS+=("${1#*=}") ;;
    --add-dir)
      if [ $# -lt 2 ] || [ "${2#-}" != "$2" ]; then
        echo "Error: --add-dir requires a directory path" >&2
        exit 1
      fi
      # Variadic, matching claude's own --add-dir: take every path up to the next flag.
      while [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; do
        ADD_DIRS+=("$2")
        shift
      done
      ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]}"

# Ensure Claude config directory exists
mkdir -p "${HOME}/.claude"

# Migrate .claude.json into .claude/ directory so we only need directory mounts
# (single-file bind mounts don't work on Mac Docker Desktop).
# Canonical location: ~/.claude/.claude.json, with ~/.claude.json as a symlink.
if [ -L "${HOME}/.claude.json" ]; then
  [ -f "${HOME}/.claude/.claude.json" ] || echo '{}' > "${HOME}/.claude/.claude.json"
elif [ -f "${HOME}/.claude.json" ] && [ -f "${HOME}/.claude/.claude.json" ]; then
  cat >&2 <<'CONFLICT'
Error: Found .claude.json in two locations:

  1. ~/.claude.json
  2. ~/.claude/.claude.json

This happened because an earlier version of claude-docker incorrectly created
the second file. Only ONE of them has your real Claude config (OAuth tokens,
settings, etc). The other is likely an empty '{}' or stale copy.

To fix this, compare the two files and keep the real one:

  diff ~/.claude.json ~/.claude/.claude.json

Then pick one:

  # If ~/.claude.json is the real one:
  cp ~/.claude.json ~/.claude/.claude.json
  rm ~/.claude.json
  ln -s ~/.claude/.claude.json ~/.claude.json

  # If ~/.claude/.claude.json is the real one:
  rm ~/.claude.json
  ln -s ~/.claude/.claude.json ~/.claude.json

After fixing, re-run this command.
CONFLICT
  exit 1
else
  # Ensure canonical file exists (copy from outer file, or create fresh)
  [ -f "${HOME}/.claude/.claude.json" ] || cp "${HOME}/.claude.json" "${HOME}/.claude/.claude.json" 2>/dev/null || echo '{}' > "${HOME}/.claude/.claude.json"
  ln -sf "${HOME}/.claude/.claude.json" "${HOME}/.claude.json"
fi

# Get local username and UID/GID
LOCAL_USER="${USER}"
LOCAL_UID="$(id -u)"
LOCAL_GID="$(id -g)"

# Resolve --add-dir paths before the build, so a bad path fails fast.
# A path that exists on the host is bind-mounted at the same path inside the
# container; the flag is forwarded to claude either way, so paths that only
# exist in the image (/opt/..., and the like) still reach it.
MOUNT_DIRS=()
FORWARD_DIRS=()
for dir in "${ADD_DIRS[@]}"; do
  if [ ! -d "$dir" ]; then
    echo "Warning: --add-dir $dir is not a directory on the host, forwarding it unmounted" >&2
    FORWARD_DIRS+=("$dir")
    continue
  fi
  # pwd -P rather than realpath, which is not present on every macOS.
  RESOLVED="$(cd "$dir" && pwd -P)"
  case "$RESOLVED" in
    # On Linux the host home and the container home are the same path, so
    # mounting it would bury the container's own home, including ~/.claude.
    /|"/home/${LOCAL_USER}")
      echo "Error: --add-dir $dir resolves to $RESOLVED, which would shadow the container's own filesystem." >&2
      echo "Add a specific subdirectory instead." >&2
      exit 1
      ;;
  esac
  # The workspace is already mounted and already in context. Docker also rejects
  # a repeated mount point, so the same directory twice has to collapse to one.
  [ "$RESOLVED" = "$(pwd)" ] && continue
  DUPLICATE=""
  for seen in "${FORWARD_DIRS[@]}"; do
    [ "$seen" = "$RESOLVED" ] && DUPLICATE=1
  done
  [ -n "$DUPLICATE" ] && continue
  FORWARD_DIRS+=("$RESOLVED")
  MOUNT_DIRS+=("$RESOLVED")
done

# Verify build context exists
if [ ! -f "$DATA_DIR/Dockerfile" ]; then
  echo "Error: Dockerfile not found at $DATA_DIR/Dockerfile" >&2
  echo "Run install.sh first." >&2
  exit 1
fi

# Stage user customize script into build context (runs as root as last build layer).
# Always (re)write so a previously-set CLAUDE_DOCKER_CUSTOMIZE doesn't linger after unset.
if [ -n "$CLAUDE_DOCKER_CUSTOMIZE" ]; then
  if [ ! -f "$CLAUDE_DOCKER_CUSTOMIZE" ]; then
    echo "Error: CLAUDE_DOCKER_CUSTOMIZE points to missing file: $CLAUDE_DOCKER_CUSTOMIZE" >&2
    exit 1
  fi
  cp "$CLAUDE_DOCKER_CUSTOMIZE" "$DATA_DIR/customize.sh"
else
  printf '#!/bin/bash\n# No customization configured (set CLAUDE_DOCKER_CUSTOMIZE to a script path).\n' \
    > "$DATA_DIR/customize.sh"
fi
chmod +x "$DATA_DIR/customize.sh"

# Build image
BUILD_ARGS=(
  --build-arg LOCAL_USER="$LOCAL_USER"
  --build-arg LOCAL_UID="$LOCAL_UID"
  --build-arg LOCAL_GID="$LOCAL_GID"
)
if [ -n "${CLAUDE_DOCKER_CC_VERSION:-}" ]; then
  BUILD_ARGS+=(--build-arg CLAUDE_CODE_VERSION="$CLAUDE_DOCKER_CC_VERSION")
fi
if ! docker build $REBUILD_FLAG \
  "${BUILD_ARGS[@]}" \
  -t "$IMAGE" \
  "$DATA_DIR"; then
  exit $?
fi

# Check if bash was requested
CMD="claude"
if [ "${1:-}" = "bash" ]; then
  CMD="bash"
  shift
fi

# Resolve host timezone (TZ env, else /etc/localtime symlink target)
HOST_TZ="${TZ:-$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')}"

# Build docker run arguments
RUN_ARGS=(
  -it --rm --init
  --add-host=host.docker.internal:host-gateway
  -v "$(pwd):$(pwd)"
  -v "${HOME}/.claude:/home/${LOCAL_USER}/.claude"
  -e LANG="C.UTF-8"
  -e LC_ALL="C.UTF-8"
  -e COLORTERM=truecolor
  -w "$(pwd)"
)

for dir in "${MOUNT_DIRS[@]}"; do
  RUN_ARGS+=(-v "$dir:$dir")
done

if [ -n "$HOST_TZ" ]; then
  RUN_ARGS+=(-e TZ="$HOST_TZ")
fi

if [ -n "${CLAUDE_DOCKER_ALLOW_DOMAINS:-}" ]; then
  RUN_ARGS+=(-e CLAUDE_DOCKER_ALLOW_DOMAINS="$CLAUDE_DOCKER_ALLOW_DOMAINS")
fi

# Pass the host git identity (name + email) so the agent commits as you.
# Off by default. Reads just the two values via git config, no file mount
# (single-file bind mounts break on Mac Docker Desktop). GIT_AUTHOR_*/
# GIT_COMMITTER_* are what git reads when creating a commit.
if [ -n "${CLAUDE_DOCKER_GIT_IDENTITY:-}" ]; then
  GIT_NAME="$(git config --get user.name 2>/dev/null)"
  GIT_EMAIL="$(git config --get user.email 2>/dev/null)"
  [ -n "$GIT_NAME" ]  && RUN_ARGS+=(-e GIT_AUTHOR_NAME="$GIT_NAME"   -e GIT_COMMITTER_NAME="$GIT_NAME")
  [ -n "$GIT_EMAIL" ] && RUN_ARGS+=(-e GIT_AUTHOR_EMAIL="$GIT_EMAIL" -e GIT_COMMITTER_EMAIL="$GIT_EMAIL")
fi

if [ -n "$NO_FIREWALL" ]; then
  RUN_ARGS+=(
    --security-opt=no-new-privileges:true
    --net=host
    --cap-drop=ALL
    -e DISABLE_FIREWALL=1
  )
else
  RUN_ARGS+=(
    --cap-drop=ALL
    --cap-add=NET_ADMIN
    --cap-add=NET_RAW
    --cap-add=SETUID
    --cap-add=SETGID
    --cap-add=AUDIT_WRITE
  )
fi

CMD_ARGS=("$@")
# Appended last: --add-dir is variadic, so anything after it would be eaten as
# another directory. Skipped for bash, which has no use for the flag.
if [ "$CMD" = "claude" ] && [ ${#FORWARD_DIRS[@]} -gt 0 ]; then
  CMD_ARGS+=(--add-dir "${FORWARD_DIRS[@]}")
fi

docker run "${RUN_ARGS[@]}" "$IMAGE" "$CMD" "${CMD_ARGS[@]}"
